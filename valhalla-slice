#!/usr/bin/env python3
"""
Valhalla TAR slicing service.
Usage:
  valhalla-slice [--tar=<tar>] [--port=<port>]
  valhalla-slice -h | --help

Options:
  -h --help      Show this screen.
  --tar=<tar>    Path to valhalla_tiles.tar [default: valhalla_tiles.tar].
  --port=<port>  Port to run the server on [default: 8000].
"""
import os
import time
import struct
import threading
import subprocess
import sys
import importlib
import tarfile
import math
from decimal import Decimal

def ensure_package(package_name):
  """Ensures a package is installed and imports it."""
  try:
    importlib.import_module(package_name)
  except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", package_name])
  return importlib.import_module(package_name)

docopt = ensure_package("docopt")
fastapi = ensure_package("fastapi")
uvicorn = ensure_package("uvicorn")
mercantile = ensure_package("mercantile")
from fastapi.responses import StreamingResponse

class ArchiveState:
  """Manages a thread-safe reference-counted file descriptor and index."""

  def __init__(self, tar_path):
    """Initializes the archive state."""
    self.fd = open(tar_path, "rb")
    self.inode = os.fstat(self.fd.fileno()).st_ino
    self.index = self._load_index()
    self.ref_count = 0
    self.retired = False
    self.lock = threading.Lock()

  def _load_index(self):
    """Parses the Valhalla index.bin file from within the tar into a dictionary."""
    index_map = {}
    fd_copy = os.dup(self.fd.fileno())
    os.lseek(fd_copy, 0, os.SEEK_SET)
    with os.fdopen(fd_copy, "rb") as f_copy:
      with tarfile.open(fileobj=f_copy, mode="r") as tar:
        for member in tar.getmembers():
          if member.name == "index.bin":
            f = tar.extractfile(member)
            file_size = member.size
            for _ in range(file_size // 16):
              chunk = f.read(16)
              tile_id = struct.unpack("<Q", chunk[0:8])[0]
              offset = struct.unpack("<I", chunk[8:12])[0]
              length = struct.unpack("<I", chunk[12:16])[0]
              index_map[tile_id] = {"offset": offset, "length": length}
            break
    return index_map

  def acquire(self):
    """Increments the reference count."""
    with self.lock:
      self.ref_count += 1

  def release(self):
    """Decrements the reference count and closes if retired."""
    with self.lock:
      self.ref_count -= 1
      if self.retired:
        if self.ref_count == 0:
          self.fd.close()

  def retire(self):
    """Marks the state as retired for eventual closure."""
    with self.lock:
      self.retired = True
      if self.ref_count == 0:
        self.fd.close()

class StateManager:
  """Manages hot-reloading of the archive state using inode polling."""

  def __init__(self, tar_path):
    """Initializes the state manager and polling thread."""
    self.tar_path = tar_path
    self.current_state = ArchiveState(tar_path)
    self.active_inode = self.current_state.inode
    self.swap_lock = threading.Lock()
    threading.Thread(target=self._poll_inode, daemon=True).start()

  def get_state(self):
    """Returns the currently active state with an incremented reference count."""
    with self.swap_lock:
      state = self.current_state
      state.acquire()
      return state

  def _poll_inode(self):
    """Polls the filesystem for inode changes every 5 minutes."""
    while True:
      time.sleep(300)
      try:
        current_inode = os.stat(self.tar_path).st_ino
        if current_inode != self.active_inode:
          self._reload()
      except FileNotFoundError:
        pass

  def _reload(self):
    """Swaps the current state with a newly loaded one."""
    try:
      new_state = ArchiveState(self.tar_path)
    except (FileNotFoundError, tarfile.TarError, OSError) as e:
      print(f"Failed to reload archive state: {e}", file=sys.stderr)
      return

    with self.swap_lock:
      old_state = self.current_state
      self.current_state = new_state
      self.active_inode = new_state.inode
    old_state.retire()

def get_valhalla_tile_ids(z, x, y):
  """
  Calculates intersecting Valhalla GraphIDs (tile IDs) for a given Z, X, Y map tile.
  
  Valhalla uses a 64-bit GraphId where bits 0-2 represent the hierarchy level,
  and bits 3-24 represent the tile index. The tile index is calculated using a
  regular grid of varying sizes per level (Level 0: 4 degrees, Level 1: 1 degree, Level 2: 0.25 degrees).
  """
  bounds = mercantile.bounds(x, y, z)
  west_dec = Decimal(str(bounds.west))
  south_dec = Decimal(str(bounds.south))
  east_dec = Decimal(str(bounds.east))
  north_dec = Decimal(str(bounds.north))
  
  offset_lon = Decimal("180.0")
  offset_lat = Decimal("90.0")

  levels = [
    (0, "4.0"),
    (1, "1.0"),
    (2, "0.25")
  ]

  tile_ids = []

  for level_info in levels:
    level = level_info[0]
    size_str = level_info[1]
    size_dec = Decimal(size_str)
    
    cols = int(Decimal("360.0") / size_dec)
    rows = int(Decimal("180.0") / size_dec)
    
    min_col = max(0, int((west_dec + offset_lon) / size_dec))
    # Aligns exact coordinate bounds to the lower grid cell index to prevent adjacent tile fetching
    max_col = min(cols - 1, int(math.ceil((east_dec + offset_lon) / size_dec)) - 1)
    
    min_row = max(0, int((south_dec + offset_lat) / size_dec))
    max_row = min(rows - 1, int(math.ceil((north_dec + offset_lat) / size_dec)) - 1)

    for row in range(min_row, max_row + 1):
      for col in range(min_col, max_col + 1):
        tile_index = (row * cols) + col
        graph_id = (tile_index << 3) | level
        tile_ids.append(graph_id)

  return tile_ids

def create_tar_header(filename, file_size):
  """Creates a POSIX-compliant 512-byte TAR header."""
  filename_bytes = filename.encode("utf-8")
  header = bytearray(512)
  header[0:len(filename_bytes)] = filename_bytes
  size_oct = oct(file_size)[2:].zfill(11).encode("utf-8")
  header[124:135] = size_oct
  header[135] = 32
  header[148:156] = b"        "
  header[156] = 48
  magic = b"ustar  \0"
  header[257:265] = magic
  checksum = sum(header)
  chksum_oct = oct(checksum)[2:].zfill(6).encode("utf-8")
  header[148:154] = chksum_oct
  header[154] = 0
  header[155] = 32
  return bytes(header)

def generate_tar_stream(state, z, x, y):
  """Yields bytes representing a dynamic TAR archive of the requested tiles."""
  try:
    tile_ids = get_valhalla_tile_ids(z, x, y)
    for tile_id in tile_ids:
      if tile_id in state.index:
        tile_info = state.index[tile_id]
        offset = tile_info["offset"]
        length = tile_info["length"]
        filename = f"{tile_id}.gph"
        header = create_tar_header(filename, length)
        yield header
        
        bytes_read = 0
        while bytes_read < length:
          read_size = length - bytes_read
          chunk = os.pread(state.fd.fileno(), read_size, offset + bytes_read)
          if not chunk:
            break
          yield chunk
          chunk_len = len(chunk)
          bytes_read += chunk_len
          
        padding_len = (512 - (length % 512)) % 512
        if padding_len > 0:
          padding = b"\0" * padding_len
          yield padding
          
    eof_marker = b"\0" * 1024
    yield eof_marker
  finally:
    state.release()

def main():
  """Parses CLI arguments and starts the FastAPI server."""
  args = docopt.docopt(__doc__)
  tar_path = args["--tar"]
  port_str = args["--port"]
  port = int(port_str)
  global state_manager
  state_manager = StateManager(tar_path)
  uvicorn.run(app, host="0.0.0.0", port=port)

app = fastapi.FastAPI()

@app.get("/valhalla-{z}-{x}-{y}.tar")
def get_tar(z: int, x: int, y: int):
  """HTTP endpoint to stream the generated TAR archive."""
  state = state_manager.get_state()
  return StreamingResponse(generate_tar_stream(state, z, x, y), media_type="application/x-tar")

if __name__ == "__main__":
  main()
