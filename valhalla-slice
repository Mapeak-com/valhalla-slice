#!/usr/bin/env python3
"""
Valhalla TAR slicing service.
Usage:
  valhalla-slice [--tar=<tar>] [--port=<port>] [--quiet | -q]
  valhalla-slice -h | --help

Options:
  -h --help      Show this screen.
  --tar=<tar>    Path to valhalla_tiles.tar [default: valhalla_tiles.tar].
  --port=<port>  Port to run the server on [default: 8000].
  -q --quiet     Disable verbose logging.
"""
import os
import time
import struct
import threading
import subprocess
import sys
import importlib
import tarfile
import math
import zlib
import tempfile
import json
from decimal import Decimal

def ensure_package(package_name):
  """Ensures a package is installed and imports it."""
  try:
    importlib.import_module(package_name)
  except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", package_name])
  return importlib.import_module(package_name)

docopt = ensure_package("docopt")
fastapi = ensure_package("fastapi")
uvicorn = ensure_package("uvicorn")
mercantile = ensure_package("mercantile")
from fastapi.responses import StreamingResponse, PlainTextResponse
from fastapi.concurrency import run_in_threadpool

MAX_POLYGON_BYTES = 64 * 1024 * 1024
SNAP_EPSILON = 1e-9

def get_tile_path(tile_id):
  """Converts a Valhalla GraphId into its tar file path representation."""
  level = tile_id & 7
  tile_index = (tile_id >> 3) & 0x3FFFFF
  if level == 2:
    return f"{level}/{tile_index // 1000000:03d}/{(tile_index // 1000) % 1000:03d}/{tile_index % 1000:03d}.gph"
  return f"{level}/{tile_index // 1000:03d}/{tile_index % 1000:03d}.gph"

class ArchiveState:
  """Manages a thread-safe reference-counted file descriptor and index."""

  def __init__(self, tar_path, verbose=True):
    """Initializes the archive state."""
    self.verbose = verbose
    self.fd = open(tar_path, "rb")
    self.inode = os.fstat(self.fd.fileno()).st_ino
    self.index_info = {}
    self.index = self._load_index()
    self.ref_count = 0
    self.retired = False
    self.lock = threading.Lock()
    if self.verbose:
      print(f"ArchiveState initialized: {len(self.index)} tiles loaded from {tar_path}")
      sample_keys = [get_tile_path(k) for k in list(self.index.keys())[:5]]
      print(f"Sample index tile_ids: {sample_keys}")

  def _load_index(self):
    """Parses the Valhalla index.bin file from within the tar into a dictionary."""
    index_map = {}
    fd_copy = os.dup(self.fd.fileno())
    os.lseek(fd_copy, 0, os.SEEK_SET)
    found_index = False
    with os.fdopen(fd_copy, "rb") as f_copy:
      with tarfile.open(fileobj=f_copy, mode="r") as tar:
        for member in tar.getmembers():
          if member.name == "index.bin":
            found_index = True
            # offset_data - 512 reliably points to the 512-byte header block
            self.index_info = {
                "size": member.size, 
                "mtime": member.mtime,
                "header_offset": member.offset_data - 512
            }
            if self.verbose:
              print(f"Located index.bin: {member.size} bytes")
            f = tar.extractfile(member)
            file_size = member.size
            for _ in range(file_size // 16):
              chunk = f.read(16)
              offset, tile_id, length = struct.unpack("<QLL", chunk)
              index_map[tile_id] = {"offset": offset, "length": length}
            break
    if self.verbose and not found_index:
      print("WARNING: index.bin not found inside the TAR archive. Index is empty.")
    return index_map

  def acquire(self):
    """Increments the reference count."""
    with self.lock:
      self.ref_count += 1

  def release(self):
    """Decrements the reference count and closes if retired."""
    with self.lock:
      self.ref_count -= 1
      if self.retired:
        if self.ref_count == 0:
          self.fd.close()

  def retire(self):
    """Marks the state as retired for eventual closure."""
    with self.lock:
      self.retired = True
      if self.ref_count == 0:
        self.fd.close()

class StateManager:
  """Manages hot-reloading of the archive state using inode polling."""

  def __init__(self, tar_path, verbose=True):
    """Initializes the state manager and polling thread."""
    self.tar_path = tar_path
    self.verbose = verbose
    self.current_state = ArchiveState(tar_path, verbose=self.verbose)
    self.active_inode = self.current_state.inode
    self.swap_lock = threading.Lock()
    threading.Thread(target=self._poll_inode, daemon=True).start()

  def get_state(self):
    """Returns the currently active state with an incremented reference count."""
    with self.swap_lock:
      state = self.current_state
      state.acquire()
      return state

  def _poll_inode(self):
    """Polls the filesystem for inode changes every 5 minutes."""
    while True:
      time.sleep(300)
      try:
        current_inode = os.stat(self.tar_path).st_ino
        if current_inode != self.active_inode:
          self._reload()
      except FileNotFoundError:
        pass

  def _reload(self):
    """Swaps the current state with a newly loaded one."""
    try:
      new_state = ArchiveState(self.tar_path, verbose=self.verbose)
    except (FileNotFoundError, tarfile.TarError, OSError) as e:
      if self.verbose:
        print(f"Failed to reload archive state: {e}", file=sys.stderr)
      return
    with self.swap_lock:
      old_state = self.current_state
      self.current_state = new_state
      self.active_inode = new_state.inode
      if self.verbose:
        print(f"Hot-reload complete. New inode: {self.active_inode}")
    old_state.retire()

def get_valhalla_tile_ids(z, x, y):
  """
  Calculates intersecting Valhalla GraphIDs (tile IDs) for a given Z, X, Y map tile.
  
  Valhalla 32-bit packed GraphId bit alignment:
    - Level: bits 0-2
    - Tile Index: bits 3-24
  """
  bounds = mercantile.bounds(x, y, z)
  west_dec = Decimal(str(bounds.west))
  south_dec = Decimal(str(bounds.south))
  east_dec = Decimal(str(bounds.east))
  north_dec = Decimal(str(bounds.north))
  offset_lon = Decimal("180.0")
  offset_lat = Decimal("90.0")
  levels = [
    (0, "4.0"),
    (1, "1.0"),
    (2, "0.25")
  ]
  tile_ids = []
  for level_info in levels:
    level = level_info[0]
    size_str = level_info[1]
    size_dec = Decimal(size_str)
    cols = int(Decimal("360.0") / size_dec)
    rows = int(Decimal("180.0") / size_dec)
    min_col = max(0, int((west_dec + offset_lon) / size_dec))
    max_col = min(cols - 1, int(math.ceil((east_dec + offset_lon) / size_dec)) - 1)
    min_row = max(0, int((south_dec + offset_lat) / size_dec))
    max_row = min(rows - 1, int(math.ceil((north_dec + offset_lat) / size_dec)) - 1)
    for row in range(min_row, max_row + 1):
      for col in range(min_col, max_col + 1):
        tile_index = (row * cols) + col
        graph_id = (tile_index << 3) | level
        tile_ids.append(graph_id)
  return tile_ids

def check_coordinate(lon, lat):
  """Converts a longitude/latitude pair to floats, rejecting values outside -180..180 / -90..90."""
  if isinstance(lon, bool) or isinstance(lat, bool):
    raise ValueError(f"invalid coordinate: {lon} {lat}")
  try:
    lon_value = float(lon)
    lat_value = float(lat)
  except (TypeError, ValueError):
    raise ValueError(f"invalid coordinate: {lon} {lat}")
  if not (-180 <= lon_value <= 180 and -90 <= lat_value <= 90):
    raise ValueError(f"invalid coordinate: {lon} {lat}")
  return (lon_value, lat_value)

def normalize_ring(points):
  """Drops a closing point equal to the first one and requires at least 3 distinct points."""
  if len(points) > 1 and points[0] == points[-1]:
    points = points[:-1]
  if len(set(points)) < 3:
    raise ValueError("a ring needs at least 3 distinct points")
  return points

def point_in_ring(point, ring):
  """Even-odd test of whether a point is inside a ring."""
  inside = False
  for i in range(len(ring)):
    start = ring[i]
    end = ring[(i + 1) % len(ring)]
    if (start[1] > point[1]) != (end[1] > point[1]):
      crossing = start[0] + (point[1] - start[1]) * (end[0] - start[0]) / (end[1] - start[1])
      if point[0] < crossing:
        inside = not inside
  return inside

def parse_geojson_polygon(rings):
  """Converts GeoJSON Polygon coordinates into a list of rings of (lon, lat) tuples."""
  if not isinstance(rings, list) or not rings:
    raise ValueError("invalid polygon coordinates")
  result = []
  for ring in rings:
    if not isinstance(ring, list):
      raise ValueError("invalid polygon coordinates")
    points = []
    for position in ring:
      if not isinstance(position, list) or len(position) < 2:
        raise ValueError(f"invalid coordinate: {position}")
      points.append(check_coordinate(position[0], position[1]))
    result.append(normalize_ring(points))
  return result

def parse_geojson(text):
  """Parses the Polygon and MultiPolygon geometries of a GeoJSON FeatureCollection, Feature or geometry."""
  try:
    data = json.loads(text)
  except ValueError as e:
    raise ValueError(f"invalid GeoJSON: {e}")
  polygons = []
  pending = [data]
  while pending:
    obj = pending.pop(0)
    if not isinstance(obj, dict):
      raise ValueError("invalid GeoJSON object")
    kind = obj.get("type")
    if kind == "FeatureCollection":
      features = obj.get("features")
      if not isinstance(features, list):
        raise ValueError("invalid GeoJSON FeatureCollection")
      pending.extend(features)
    elif kind == "Feature":
      if obj.get("geometry") is not None:
        pending.append(obj["geometry"])
    elif kind == "Polygon":
      polygons.append(parse_geojson_polygon(obj.get("coordinates")))
    elif kind == "MultiPolygon":
      coordinates = obj.get("coordinates")
      if not isinstance(coordinates, list):
        raise ValueError("invalid MultiPolygon coordinates")
      for rings in coordinates:
        polygons.append(parse_geojson_polygon(rings))
  return polygons

def parse_poly(text):
  """Parses an Osmosis .poly file; a ring whose header starts with '!' is a hole in each preceding ring that contains it."""
  lines = text.splitlines()
  polygons = []
  i = 1
  finished = False
  while i < len(lines):
    header = lines[i].strip()
    i += 1
    if not header:
      continue
    if header == "END":
      finished = True
      break
    points = []
    closed = False
    while i < len(lines):
      line = lines[i].strip()
      i += 1
      if line == "END":
        closed = True
        break
      if not line:
        continue
      parts = line.split()
      if len(parts) != 2:
        raise ValueError(f"invalid coordinate on line {i}: {line}")
      points.append(check_coordinate(parts[0], parts[1]))
    if not closed:
      raise ValueError(f"unclosed ring: {header}")
    ring = normalize_ring(points)
    if header.startswith("!"):
      for polygon in polygons:
        if point_in_ring(ring[0], polygon[0]):
          polygon.append(ring)
    else:
      polygons.append([ring])
  if not finished:
    raise ValueError("missing final END")
  if any(line.strip() for line in lines[i:]):
    raise ValueError("content after final END")
  return polygons

def parse_polygon(text):
  """Parses GeoJSON (first non-space character '{') or Osmosis .poly text into polygons, each a list of rings."""
  if text.lstrip().startswith("{"):
    polygons = parse_geojson(text)
  else:
    polygons = parse_poly(text)
  if not polygons:
    raise ValueError("no polygon geometry")
  return polygons

def snap(value):
  """Snaps a value within SNAP_EPSILON of a whole number to that number."""
  nearest = round(value)
  if abs(value - nearest) < SNAP_EPSILON:
    return float(nearest)
  return value

def add_boundary_cells(ring, cells):
  """Adds the cells whose interior a ring segment passes through, in fractional cell coordinates."""
  for i in range(len(ring)):
    start = ring[i]
    end = ring[(i + 1) % len(ring)]
    du = end[0] - start[0]
    dv = end[1] - start[1]
    params = {0.0, 1.0}
    if du != 0:
      for k in range(math.ceil(min(start[0], end[0])), math.floor(max(start[0], end[0])) + 1):
        params.add((k - start[0]) / du)
    if dv != 0:
      for k in range(math.ceil(min(start[1], end[1])), math.floor(max(start[1], end[1])) + 1):
        params.add((k - start[1]) / dv)
    ordered = sorted(t for t in params if 0 <= t <= 1)
    for j in range(len(ordered) - 1):
      t = (ordered[j] + ordered[j + 1]) / 2
      u = snap(start[0] + du * t)
      v = snap(start[1] + dv * t)
      if u != math.floor(u) and v != math.floor(v):
        cells.add((math.floor(u), math.floor(v)))

def add_interior_cells(polygon, cells):
  """Adds the cells whose center is inside the polygon, using the even-odd rule over all its rings."""
  rows_v = [point[1] for point in polygon[0]]
  for row in range(math.floor(min(rows_v)), math.ceil(max(rows_v))):
    center = row + 0.5
    crossings = []
    for ring in polygon:
      for i in range(len(ring)):
        start = ring[i]
        end = ring[(i + 1) % len(ring)]
        if (start[1] > center) != (end[1] > center):
          crossings.append(start[0] + (center - start[1]) * (end[0] - start[0]) / (end[1] - start[1]))
    crossings.sort()
    for i in range(0, len(crossings) - 1, 2):
      first_col = math.floor(crossings[i] - 0.5) + 1
      last_col = math.ceil(crossings[i + 1] - 0.5) - 1
      for col in range(first_col, last_col + 1):
        cells.add((col, row))

def get_valhalla_tile_ids_polygon(polygons):
  """
  Calculates the Valhalla GraphIDs (tile IDs) of the cells that overlap the polygons, excluding cells that only touch them.
  A cell overlaps when a ring segment passes through its interior or its center is inside a polygon.
  """
  levels = [
    (0, 4.0),
    (1, 1.0),
    (2, 0.25)
  ]
  tile_ids = []
  for level_info in levels:
    level = level_info[0]
    size = level_info[1]
    cols = int(360 / size)
    rows = int(180 / size)
    cells = set()
    for polygon in polygons:
      grid_polygon = [[(snap((lon + 180) / size), snap((lat + 90) / size)) for lon, lat in ring] for ring in polygon]
      for ring in grid_polygon:
        add_boundary_cells(ring, cells)
      add_interior_cells(grid_polygon, cells)
    for cell in sorted(cells, key=lambda c: (c[1], c[0])):
      if 0 <= cell[0] < cols and 0 <= cell[1] < rows:
        tile_index = (cell[1] * cols) + cell[0]
        tile_ids.append((tile_index << 3) | level)
  return tile_ids

def has_index_header(state):
  """Whether an original index.bin TAR header exists to be patched and re-emitted."""
  return bool(state.index_info and "header_offset" in state.index_info)

def generate_tar_stream(state, found_tiles, verbose=True):
  """Yields bytes representing a dynamic TAR archive of found_tiles, including an updated index.bin."""
  try:
    if verbose:
      sample_requested = [get_tile_path(t) for t in found_tiles[:5]]
      print(f"Sample requested tile_ids: {sample_requested}")
    # 1. Dynamically calculate the new index.bin contents and offsets for this slice
    index_size = len(found_tiles) * 16
    index_padding_len = (512 - (index_size % 512)) % 512
    index_block_size = 512 + index_size + index_padding_len
    if has_index_header(state):
      orig_idx_header = os.pread(state.fd.fileno(), 512, state.index_info["header_offset"])
      header = bytearray(orig_idx_header)
      # Patch the file size (bytes 124-135)
      size_oct = oct(index_size)[2:].zfill(11).encode("utf-8")
      header[124:135] = size_oct
      header[135] = 32
      # Patch the modification time to now (bytes 136-147)
      current_time = int(time.time())
      mtime_oct = oct(current_time)[2:].zfill(11).encode("utf-8")
      header[136:147] = mtime_oct
      header[147] = 32
      # Clear checksum area (bytes 148-155) to recalculate
      header[148:156] = b"        "
      checksum = sum(header)
      chksum_oct = oct(checksum)[2:].zfill(6).encode("utf-8")
      # Insert new checksum
      header[148:154] = chksum_oct
      header[154] = 0
      header[155] = 32
      yield bytes(header)
    # 2. Build and yield the index.bin body
    current_tar_offset = index_block_size
    index_bytes = bytearray()
    for tile_id in found_tiles:
      length = state.index[tile_id]["length"]
      content_offset = current_tar_offset + 512  # Account for this tile's 512-byte header
      index_bytes.extend(struct.pack("<QLL", content_offset, tile_id, length))
      # Advance the tracker for the next tile
      tile_padding_len = (512 - (length % 512)) % 512
      current_tar_offset += 512 + length + tile_padding_len
    yield bytes(index_bytes)
    if index_padding_len > 0:
      yield b"\0" * index_padding_len
    # 3. Stream the requested graph tiles using original file headers
    found_count = 0
    for tile_id in found_tiles:
      found_count += 1
      tile_info = state.index[tile_id]
      offset = tile_info["offset"]
      length = tile_info["length"]
      header = os.pread(state.fd.fileno(), 512, offset - 512)
      yield header
      bytes_read = 0
      while bytes_read < length:
        read_size = length - bytes_read
        chunk = os.pread(state.fd.fileno(), read_size, offset + bytes_read)
        if not chunk:
          break
        yield chunk
        bytes_read += len(chunk)
      padding_len = (512 - (length % 512)) % 512
      if padding_len > 0:
        yield b"\0" * padding_len
    if verbose:
      print(f"Successfully streamed {found_count} tiles")
    eof_marker = b"\0" * 1024
    yield eof_marker
  finally:
    state.release()

def generate_tgz_stream(state, found_tiles, verbose=True):
  """Yields bytes representing a dynamic GZIP-compressed TAR archive."""
  compressor = zlib.compressobj(wbits=31)
  for chunk in generate_tar_stream(state, found_tiles, verbose):
    compressed_chunk = compressor.compress(chunk)
    if compressed_chunk:
      yield compressed_chunk
  yield compressor.flush()

def tar_size(state, found_tiles):
  """Returns the number of bytes generate_tar_stream yields for found_tiles."""
  index_size = len(found_tiles) * 16
  size = index_size + (512 - (index_size % 512)) % 512 + 1024
  if has_index_header(state):
    size += 512
  for tile_id in found_tiles:
    length = state.index[tile_id]["length"]
    size += 512 + length + (512 - (length % 512)) % 512
  return size

def generate_list_stream(state):
  """Yields a text representation of the tar contents based on the index."""
  try:
    tar_stat = os.stat(state.fd.name)
    if hasattr(state, "index_info") and state.index_info:
      idx_size = state.index_info.get("size", 0)
      idx_time = state.index_info.get("mtime", tar_stat.st_mtime)
      idx_date = time.strftime("%Y-%m-%d %H:%M", time.localtime(idx_time))
      yield f"-rw-r--r-- {'0/0':<13} {idx_size:>8} {idx_date} index.bin\n"
    sorted_items = sorted(state.index.items(), key=lambda x: x[1]["offset"])
    for tile_id, info in sorted_items:
      path = get_tile_path(tile_id)
      length = info["length"]
      offset = info["offset"]
      header = os.pread(state.fd.fileno(), 512, offset - 512)
      try:
        mtime_octal = header[136:148].decode("utf-8").strip("\x00 ")
        mtime = int(mtime_octal, 8)
        gph_date = time.strftime("%Y-%m-%d %H:%M", time.localtime(mtime))
      except (ValueError, UnicodeDecodeError):
        gph_date = time.strftime("%Y-%m-%d %H:%M", time.localtime(tar_stat.st_mtime))
      yield f"-rw-r--r-- {'ubuntu/ubuntu':<13} {length:>8} {gph_date} {path}\n"
  finally:
    state.release()

def main():
  """Parses CLI arguments and starts the FastAPI server."""
  args = docopt.docopt(__doc__)
  tar_path = args["--tar"]
  port_str = args["--port"]
  port = int(port_str)
  verbose_flag = not bool(args["--quiet"])
  global state_manager
  state_manager = StateManager(tar_path, verbose=verbose_flag)
  uvicorn.run(app, host="0.0.0.0", port=port, access_log=False)

app = fastapi.FastAPI()

@app.middleware("http")
async def log_requests(request: fastapi.Request, call_next):
  """Logs each request using the decoded path, so only percent-encodings actually required by the URL (not encodings the client added defensively) show up in the log."""
  response = await call_next(request)
  if state_manager.verbose:
    client_addr = f"{request.client.host}:{request.client.port}" if request.client else "-"
    http_version = request.scope.get("http_version", "1.1")
    print(f'{client_addr} - "{request.method} {request.url.path} HTTP/{http_version}" {response.status_code}')
  return response

def stream_file_and_close(temp_file):
  """Yields chunks from a temporary file and closes it when done."""
  try:
    while True:
      chunk = temp_file.read(65536)
      if not chunk:
        break
      yield chunk
  finally:
    temp_file.close()

def build_tgz_response(state, tile_ids, filename):
  """Builds the GZIP-compressed TAR archive of the indexed tiles among tile_ids and returns it as a download."""
  found_tiles = [t for t in tile_ids if t in state.index]
  max_spool_bytes = 5 * 1024 * 1024
  temp_file = tempfile.SpooledTemporaryFile(max_size=max_spool_bytes, mode="w+b")
  for chunk in generate_tgz_stream(state, found_tiles, state.verbose):
    temp_file.write(chunk)
  total_size = temp_file.tell()
  temp_file.seek(0)
  return StreamingResponse(
    stream_file_and_close(temp_file),
    media_type="application/gzip",
    headers={"Content-Length": str(total_size), "Content-Disposition": f"attachment; filename={filename}"},
  )

def build_tar_response(state, tile_ids, filename):
  """Returns the TAR archive of the indexed tiles among tile_ids as a download whose Content-Length is computed before any data is read."""
  found_tiles = [t for t in tile_ids if t in state.index]
  return StreamingResponse(
    generate_tar_stream(state, found_tiles, state.verbose),
    media_type="application/x-tar",
    headers={"Content-Length": str(tar_size(state, found_tiles)), "Content-Disposition": f"attachment; filename={filename}"},
  )

def build_archive_response(state, tile_ids, filename):
  """Returns the TAR archive for a .tar filename, otherwise the GZIP-compressed TAR archive."""
  if filename.endswith(".tar"):
    return build_tar_response(state, tile_ids, filename)
  return build_tgz_response(state, tile_ids, filename)

@app.get("/valhalla+{z}-{x}-{y}.tgz")
@app.get("/valhalla+{z}-{x}-{y}.tar")
def get_tgz(z: int, x: int, y: int, request: fastapi.Request):
  """HTTP endpoint to stream the generated TAR archive, compressed with GZIP for .tgz."""
  ext = request.url.path.rsplit(".", 1)[1]
  state = state_manager.get_state()
  tile_ids = get_valhalla_tile_ids(z, x, y)
  if state.verbose:
    print(f"Streaming {ext} request for z={z}, x={x}, y={y}. Requires {len(tile_ids)} tiles.")
  return build_archive_response(state, tile_ids, f"valhalla+{z}-{x}-{y}.{ext}")

def polygon_response(text, ext):
  """Returns the archive of the tiles covered by a GeoJSON or .poly polygon, or 400 when it does not parse."""
  try:
    polygons = parse_polygon(text)
  except ValueError as e:
    return PlainTextResponse(f"{e}\n", status_code=400)
  tile_ids = get_valhalla_tile_ids_polygon(polygons)
  state = state_manager.get_state()
  if state.verbose:
    print(f"Streaming {ext} request for a polygon. Requires {len(tile_ids)} tiles.")
  return build_archive_response(state, tile_ids, f"valhalla.{ext}")

@app.get("/valhalla.tgz")
@app.get("/valhalla.tar")
def get_polygon_tgz(request: fastapi.Request):
  """HTTP endpoint for the archive of the tiles covered by the URL-encoded polygon parameter."""
  polygons = request.query_params.getlist("polygon")
  if len(polygons) > 1:
    return PlainTextResponse("polygon given more than once\n", status_code=400)
  if not polygons or not polygons[0].strip():
    return PlainTextResponse("missing polygon\n", status_code=400)
  return polygon_response(polygons[0], request.url.path.rsplit(".", 1)[1])

@app.post("/valhalla.tgz")
@app.post("/valhalla.tar")
async def post_polygon_tgz(request: fastapi.Request):
  """HTTP endpoint for the archive of the tiles covered by the polygon in the raw request body."""
  if "polygon" in request.query_params:
    return PlainTextResponse("POST takes the polygon in the body, not the polygon parameter\n", status_code=400)
  body = bytearray()
  async for chunk in request.stream():
    body.extend(chunk)
    if len(body) > MAX_POLYGON_BYTES:
      return PlainTextResponse(f"polygon larger than {MAX_POLYGON_BYTES} bytes\n", status_code=413)
  try:
    text = body.decode("utf-8")
  except UnicodeDecodeError:
    return PlainTextResponse("polygon is not UTF-8 text\n", status_code=400)
  if not text.strip():
    return PlainTextResponse("missing polygon\n", status_code=400)
  return await run_in_threadpool(polygon_response, text, request.url.path.rsplit(".", 1)[1])

